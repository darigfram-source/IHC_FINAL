# ==============================================================================
# VARIABLES DE ENTORNO: NUTRIMASA WEB DASHBOARD
# ==============================================================================

# 1. Base de datos PostgreSQL (Supabase / Neon / Vercel Postgres)
# Formato general de PostgreSQL Connection String:
# postgresql://postgres:[TU_PASSWORD]@[TU_HOST]:5432/[TU_DATABASE]?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/nutrimasa?sslmode=require"

# 2. En caso de usar Vercel Postgres directo:
POSTGRES_URL="postgresql://default:password@ep-nutrimasa.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# 3. En caso de usar Supabase API:
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# 4. Modo de ejecución (production / development)
NODE_ENV="development"
